#solution(
  1,
  [
    'नदीभिश्च' (२.१.२०) सूत्रेण सङ्ख्यावाचक-शब्दानां नदीवाचिभिः शब्दैः सह समासे अव्ययीभावः भवति, न तु द्विगुः। अतः 'पञ्चगङ्गम्' इत्यत्र अव्ययीभाव-समासः अस्ति।
  ],
  answer: [A],
)

