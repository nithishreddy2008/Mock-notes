#mcq(4, [The militant social organization 'Dalit Panthers', inspired by the Black Panther movement in the US, was founded in May 1972 in which Indian state?], (
  [Uttar Pradesh], [Maharashtra], [Bihar], [Punjab],
))

#solution(4, [The Dalit Panthers was founded in Maharashtra (specifically in the slums of Bombay) in May 1972 by young writers and activists resisting entrenched rural caste atrocities.], answer: [B])

#mcq(5, [Who was the renowned Marathi poet and co-founder of the Dalit Panthers who authored the revolutionary poetry collection 'Golpitha'?], (
  [Namdeo Dhasal], [Kanshi Ram], [Ram Vilas Paswan], [B.R. Ambedkar],
))

#solution(5, [Namdeo Dhasal, a pathbreaking Marathi poet who wrote 'Golpitha', co-founded the Dalit Panthers alongside J.V. Pawar and Arjun Dangle in 1972.], answer: [A])

