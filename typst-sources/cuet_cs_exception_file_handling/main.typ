  ```python
  class BankingError(Exception):
      """Base exception for all domain errors."""
      pass

  class InsufficientFundsError(BankingError):
      def __init__(self, account_id, balance, required):
          super().__init__(f"Account {account_id}: Balance {balance} < Required {required}")
          self.account_id = account_id
          self.balance = balance
          self.required = required

  def withdraw(acc_id, balance, amount):
      try:
          if amount > balance:
              raise InsufficientFundsError(acc_id, balance, amount)
          return balance - amount
      except InsufficientFundsError as err:
          # Explicit exception chaining with from
          raise RuntimeError("Transaction processing failed") from err
  ```
