#mcq(
  2,
  ["उपसर्गेण धात्वर्थो बलादन्यत्र नीयते" इत्यत्र 'हृ' धातोः 'वि' उपसर्गेण निष्पन्नस्य 'विहरति' इत्यस्य कः अर्थः?],
  (
    [आघातं करोति],
    [भ्रमणं करोति (घूमना)],
    [विनाशं करोति],
    [भोजनं करोति],
  ),
)
#solution(
  2,
  [
    'प्रहाराहारसंहारविहारपरिहारवत्' इति कारिकानुसारं वि + हृ = विहरति (भ्रमणं करोति/घूमना)। प्रहरति = आघात करना, आहरति = भोजन/लाना, संहरति = विनाश करना, परिहरति = त्यागना।
  ],
  answer: [B],
)

#mcq(
  3,
  ["ह्यः मम भ्राता ग्रामम् [......]।" — अस्मिन् रिक्तस्थाने कालसङ्गतं शुद्धं क्रियापदं किम्?],
  (
    [गमिष्यति],
    [गच्छति],
    [अगच्छत्],
    [गच्छतु],
  ),
)
#solution(
  3,
  [
    'ह्यः' (बीता हुआ कल) इति कालवाचकम् अव्ययं भूतकालं निर्दिशति। अतः अस्य योगे लङ्-लकारस्य (भूतकालस्य) प्रथमपुरुष-एकवचनस्य रूपं 'अगच्छत्' एव शुद्धं भवति।
  ],
  answer: [C],
)

#mcq(
