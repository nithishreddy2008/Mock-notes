#mcq(
  15,
  ["सदृशं त्रिषु लिङ्गेषु सर्वासु च विभक्तिषु। वचनेषु च सर्वेषु यन्न व्येति तदव्ययम्॥" — एतत् कस्य लक्षणम्?],
  (
    [उपसर्गस्य],
    [धातोः],
    [प्रत्ययस्य],
    [अव्ययस्य],
  ),
)
#solution(
  15,
  [
    इदं श्लोकरूपं लक्षणं महाभाष्ये गोणर्दीय-पतञ्जलिना प्रोक्तं प्रसिद्धम् 'अव्यय' लक्षणम् अस्ति। यत् त्रिषु लिङ्गेषु, सर्वासु विभक्तिषु, सर्वेषु वचनेषु समानं तिष्ठति न व्येति (न परिवर्तते) तदव्ययम्।
  ],
  answer: [D],
)
