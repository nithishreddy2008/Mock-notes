  [Week 2], [Important days + famous firsts tables], [Week 1 tables (15-min scan)],
  [Week 3], [Geography + polity anchors], [Weeks 1–2 tables + start daily news grids],
  [Week 4], [Daily grids only; build month-1 consolidation page], [All static tables, weekly quiz],
  [Weeks 5–6], [Daily grids continue; fill category gaps you miss most], [Alternate static halves on odd/even days],
  [Weeks 7–8], [Daily grids continue; month-2 consolidation page], [Full revision: all tables + both consolidation pages; final currency check],
)

