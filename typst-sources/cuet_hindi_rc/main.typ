#mcq(
  6,
  [गद्यांश में प्रयुक्त शब्द 'युगांतरकारी' का सही संधि-विच्छेद एवं संधि का प्रकार निम्नलिखित में से कौन-सा है?],
  (
    [युग + अंतरकारी — गुण स्वर संधि],
    [युग + अंतरकारी — दीर्घ स्वर संधि],
    [युगां + तरकारी — व्यंजन संधि],
    [युगः + अंतरकारी — विसर्ग संधि],
  ),
)
#solution(
  6,
  [
    'युगांतरकारी' का संधि-विच्छेद 'युग + अंतरकारी' होता है। यहाँ प्रथम पद के अंत में 'अ' तथा द्वितीय पद के आदि में 'अ' मिलकर दीर्घ 'आ' का निर्माण करते हैं ($"अ" + "अ" = "आ"$), जो कि 'दीर्घ स्वर संधि' का प्रत्यक्ष उदाहरण है।
  ],
  answer: [B],
)

