  [यास्काचार्य-प्रणीते "निरुक्ते" वार्ष्यायणि-मतानुसारेण कति भावविकाराः परिगणिताः सन्ति?],
  (
    [चत्वारः (४)],
    [षट् (६)],
    [पञ्च (५)],
    [सप्त (७)],
  ),
)
#solution(
  9,
  [
    निरुक्ते वार्ष्यायणि-मतेन षट् (६) भावविकाराः सन्ति: (१) जायते, (२) अस्ति, (३) विपरिणमते, (४) वर्धते, (५) अपक्षीयते, (६) विनश्यति।
  ],
  answer: [B],
)

#mcq(
  10,
  ["चरैवेति चरैवेति" (चलते रहो) इति प्रसिद्धः उपदेशः कस्मन् ब्राह्मण-ग्रन्थे प्राप्यते?],
  (
    [शतपथ-ब्राह्मणम्],
    [गोपथ-ब्राह्मणम्],
    [ऐतरेय-ब्राह्मणम्],
    [ताण्ड्य-ब्राह्मणम्],
  ),
)
#solution(
  10,
  [
    ऋग्वेदीये ऐतरेय-ब्राह्मणे (७.१५) शुनःशेप-आख्याने इन्द्रः राजा हरिश्चन्द्रस्य पुत्रं रोहितं प्रति सततं कर्मशीलाय 'चरैवेति चरैवेति' इति उपदिशति।
  ],
  answer: [C],
)

