#mcq(
  11,
  [ऋग्वेदस्य अष्टम-मण्डले संकलितानां "बालखिल्य-सूक्तानां" संख्या कति अस्ति?],
  (
    [दश (१०)],
    [द्वादश (१२)],
    [पञ्चदश (१५)],
    [एकादश (११)],
  ),
)
#solution(
  11,
  [
    ऋग्वेदस्य अष्टम-मण्डले ४९ तः ५९ सूक्तानि यावत् कुल ११ (एकादश) बालखिल्य-सूक्तानि सन्ति। एतानि योजयित्वा एव ऋग्वेदे कुल १०२८ (१०१७ + ११) सूक्तानि भवन्ति।
  ],
  answer: [D],
)

#mcq(
  12,
  ["माता भूमिः पुत्रोऽहं पृथिव्याः" इति राष्ट्रिय-चेतनायाः अमर-मन्त्रः कस्य वेदस्य सूक्ते वर्तते?],
  (
    [अथर्ववेदस्य पृथिवी-सूक्ते (१२.१)],
    [ऋग्वेदस्य पुरुष-सूक्ते],
    [यजुर्वेदस्य शिवसङ्कल्प-सूक्ते],
    [सामवेदस्य आर्चिके],
  ),
)
#solution(
  12,
  [
    अथर्ववेदस्य द्वादश-काण्डस्य प्रथमे सूक्ते (पृथिवीसूक्ते / भूमिसूक्ते १२.१.१२) 'माता भूमिः पुत्रोऽहं पृथिव्याः' इति सार्वभौमं राष्ट्रिय-मन्त्रं प्राप्यते।
  ],
  answer: [A],
)

#mcq(
  13,
  [वैदिक-साहित्यस्य विशालतमं ब्राह्मणं "शतपथ-ब्राह्मणम्" कस्य वेदस्य ग्रन्थः अस्ति?],
  (
    [ऋग्वेदस्य],
    [शुक्ल-यजुर्वेदस्य],
    [सामवेदस्य],
    [अथर्ववेदस्य],
  ),
)
#solution(
  13,
  [
    शतपथ-ब्राह्मणं शुक्लयजुर्वेदस्य (माध्यन्दिना-काण्व शाखयोः) ब्राह्मणम् अस्ति। अस्मिन् १०० अध्यायाः १४ काण्डानि च सन्ति। अस्य प्रणेता महर्षिः याज्ञवल्क्यः अस्ति।
  ],
  answer: [B],
)

#mcq(
  14,
  [कठोपनिषदि नचिकेता यमराजं प्रति स्वस्य तृतीये वरे किं प्रार्थितवान्?],
  (
    [पितुः सौमनस्यम्],
    [स्वर्ग-साधिकां स्वर्गाग्नि-विद्याम्],
    [आत्म-ज्ञानम् (मृत्योः परं किं भवति)],
    [चक्रवर्ती-राज्यम्],
  ),
)
#solution(
  14,
  [
    कठोपनिषदि नचिकेता प्रथम-वरे पितुः प्रसन्नतां, द्वितीय-वरे स्वर्गाग्नि-विद्यां तथा तृतीये वरे गूढम् आत्म-ज्ञानं (मृत्यु-रहस्यं) प्रार्थितवान्।
  ],
  answer: [C],
)

#mcq(
  15,
  [खगोलीय-गणना-आधारेण वेदानां रचनाकालं ४००० तः ६००० ई.पू. कः भारतीय-विद्वान् प्रतिपादितवान्?],
  (
    [दयानन्दसरस्वती],
    [मैक्समूलरः],
    [अविनाशचन्द्रदासः],
    [बालगङ्गाधर-तिलकः],
  ),
)
#solution(
  15,
  [
    लोकमान्य-बालगङ्गाधर-तिलकेन स्वकीये प्रसिद्धे 'ओरायन' (The Orion) ग्रन्थे वसन्त-सम्पातस्य मृगशिरा-नक्षत्रे स्थितिम् आधारीकृत्य वेदानां कालः ६००० तः ४००० ई.पू. निर्धारितः।
  ],
  answer: [D],
)
