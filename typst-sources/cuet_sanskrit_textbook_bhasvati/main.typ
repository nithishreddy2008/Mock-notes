  [शार्दूलविक्रीडित-छन्दसि प्रतिपादं १९ वर्णाः भवन्ति। सूर्यैः (द्वादश-आदित्यैः = १२) तथा अश्वैः (सप्त-अश्वैः = ७) वर्णेषु यतिः भवति (१२ + ७ = १९)।],
  answer: [C]
)

#mcq(
  12,
  [तैत्तिरीयोपनिषदः अनुशासन-पाठानुसारं “यान्यनवद्यानि कर्माणि [...]” इत्यस्य वाक्यस्य शुद्धः अर्थः कः अस्ति?],
  (
    [सर्वप्रकाराणि कर्माणि कर्तव्यानि],
    [केवलं धनदायक-कर्माणि कर्तव्यानि],
    [कदापि किमपि कर्म न कर्तव्यम्],
    [यानि अनिन्दितानि प्रशस्तानि कर्माणि, तान्येव आचरणीयानि]
  )
)
#solution(
  12,
  [‘अनवद्यानि’ नाम अनिन्दितानि, निर्दोषाणि, पुण्यानि कर्माणि। आचार्यः उपदिशति यत् यानि निर्दोष-कर्माणि सन्ति, तान्येव सेवितव्यानि, दोषयुक्तानि इतराणि कर्माणि कदापि न करणीयानि।],
  answer: [D]
)

#mcq(
  13,
  [प्रतिचरणं १५ वर्ण-युक्ते ‘मालिनी’ वृत्ते कति-वर्णेषु यतिः (विरामः) भवति?],
  (
    [८ तथा ७ वर्णेषु (भोगिलोकैः)],
    [७ तथा ८ वर्णेषु],
    [६ तथा ९ वर्णेषु],
    [१० तथा ५ वर्णेषु]
  )
)
#solution(
  13,
  [“ननमयययुतेयं मालिनी भोगिलोकैः” — अत्र भोगि (अष्ट-सर्पाः = ८) तथा लोकैः (सप्त-लोकाः = ७) वर्णेषु यतिः भवति (८ + ७ = १५ वर्णाः)।],
  answer: [A]
)

#mcq(
  14,
  [वेदाङ्गेषु छन्दसः किं स्थानं निर्धारितम् अस्ति?],
  (
    [छन्दः मुखं वेदस्य],
    [छन्दः पादौ तु वेदस्य],
    [छन्दः नेत्रं वेदस्य],
    [छन्दः घ्राणं वेदस्य]
  )
)
#solution(
  14,
  [पाणिनीय-शिक्षायाम् उक्तम्: “छन्दः पादौ तु वेदस्य हस्तौ कल्पोऽथ पठ्यते। ज्योतिषामयनं चक्षुर्निरुक्तं श्रोत्रमुच्यते॥ शिक्षा घ्राणं तु वेदस्य मुखं व्याकरणं स्मृतम्॥” अतः छन्दः वेदस्य पादौ स्तः।],
  answer: [B]
)

#mcq(
  15,
  [“म्राभ्नैर्यानां त्रयेण त्रिमुनियुतियुता [...] कीर्तितेयम्” — अस्मिन् २१-वर्ण-युक्ते वृत्ते कति ‘य-गणाः’ भवन्ति?],
  (
    [एकः य-गणः],
    [द्वौ य-गणौ],
    [त्रयः य-गणाः],
    [चत्वारः य-गणाः]
  )
)
#solution(
  15,
  [स्रग्धरा-वृत्तस्य गण-विन्यासः: म-गणः, र-गणः, भ-गणः, न-गणः तथा ‘यानां त्रयेण’ अर्थात् त्रयः य-गणाः (म, र, भ, न, य, य, य = २१ वर्णाः)। त्रिमुनि (७, ७, ७) वर्णेषु यतिः भवति।],
  answer: [C]
)
