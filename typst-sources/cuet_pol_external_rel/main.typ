Ten questions in the CUET UG style. Attempt all of them — the paper gives $+5$ for each correct answer and $-1$ for every incorrect answer.

#mcq(1, [The Panchsheel Agreement of 1954 was signed between India and:], (
  [the Soviet Union], [China], [the United States], [Nepal],
))

#mcq(2, [The first summit of the Non-Aligned Movement was held in 1961 at:], (
  [Bandung], [Cairo], [Belgrade], [Jakarta],
))

#mcq(3, [During the 1962 Sino-Indian war, the Indian Defence Minister who resigned was:], (
  [Y.B. Chavan], [V.K. Krishna Menon], [S.K. Patil], [Morarji Desai],
))

#mcq(4, [The Prime Minister of India during the 1965 war with Pakistan was:], (
  [Jawaharlal Nehru], [Indira Gandhi], [Morarji Desai], [Lal Bahadur Shastri],
))

#mcq(5, [The Treaty of Peace, Friendship and Cooperation of August 1971 was signed between India and:], (
  [the United States], [the Soviet Union], [Bangladesh], [China],
))

#mcq(6, [Bangladesh came into existence as an independent country in:], (
  [March 1971], [August 1971], [December 1971], [July 1972],
))

#mcq(7, [India's first nuclear test at Pokhran (codename "Smiling Buddha") was conducted in:], (
  [1968], [1971], [1974], [1998],
))

