#mcq(
  14,
  [\"तच्छिवः\" पदस्य शुद्धः सन्धि-विच्छेदः कः अस्ति?],
  (
    [तच् + छिवः],
    [तत् + शिवः],
    [तद् + छिवः],
    [तस् + शिवः],
  ),
)
#solution(
  14,
  [
    'तत् + शिवः' इत्यत्र श्चुत्वेन तकारस्य चकारे ततः 'शश्छोऽटि' (८.४.६३) सूत्रेण शकारस्य छकारे सति 'तच्छिवः' रूपं निष्पद्यते। अतः मूलविच्छेदः 'तत् + शिवः' अस्ति।
  ],
  answer: [B],
)

#mcq(
  15,
  [\"निः + रसः\" इत्यस्य शुद्धं सन्धिरूपं किम् अस्ति?],
  (
    [निरसः],
    [निःरसः],
    [नीरसः],
    [निर्रसः],
  ),
)
#solution(
  15,
  [
    'रो रि' सूत्रेण विसर्गस्य रेफे कृते रेफलोपे सति 'ढ्रलोपे पूर्वस्य दीर्घोऽणः' (६.३.१११) सूत्रेण पूर्वस्वरस्य ह्रस्व-इकारस्य दीर्घे 'नीरसः' रूपं सिध्यति।
  ],
  answer: [C],
)
