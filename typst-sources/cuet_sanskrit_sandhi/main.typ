#worked-example("CUET अभ्यास-प्रकरणम् १३ : 'अक्षौहिणी' पदे वार्तिक-वृद्धिः")[
  *अशुद्ध-विच्छेदः:* अक्षौ + हिनी अथवा अक्ष + ओहिणी।\
  *दोष-विश्लेषणम्:* 'अक्षादूहिन्यामुपसंख्यानम्' वार्तिकेन 'अक्ष' शब्दात् परस्य 'ऊहिनी' शब्दस्य गुणं बाधित्वा वृद्धिः (औ) एकादेशो भवति। ततः णत्वेन 'अक्षौहिणी' रूपं सिध्यति।\
  *शुद्ध-विच्छेदः:* *अक्ष + ऊहिनी = अक्षौहिणी (वृद्धि-वार्तिकम्)*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १४ : 'सुखार्तः' पदे तृतीयासमासे वृद्धिः")[
  *अशुद्ध-सन्धिः:* सुख + ऋतः = सुखर्तः (गुण-दोषः)।\
  *दोष-विश्लेषणम्:* तृतीया-तत्पुरुष-समासे 'ऋते च तृतीयासमासे' (६.१.८९) सूत्रेण गुणं बाधित्वा वृद्धिः (आर्) भवति। सुखेनान्तः = सुखार्तः।\
  *शुद्ध-सन्धिः:* *सुख + ऋतः = सुखार्तः*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १५ : 'प्रत्यङ्ङात्मा' पदे ङमुडागमः")[
  *अशुद्ध-विच्छेदः:* प्रत्यङ्ङ् + आत्मा अथवा प्रत्य + ङ्ङात्मा।\
  *दोष-विश्लेषणम्:* 'ङमो ह्रस्वादचि ङमुण्नित्यम्' (८.३.३२) सूत्रेण ह्रस्वस्वरात् परस्य पदान्त-ङकारस्य स्वरे परे द्वितीय-ङकारः (ङमुडागमः) भवति।\
  *शुद्ध-विच्छेदः:* *प्रत्यङ् + आत्मा = प्रत्यङ्ङात्मा*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १६ : 'षट् सन्तः' पदे ष्टुत्व-निषेधः")[
  *अशुद्ध-सन्धिः:* षट् + सन्तः = षट् षण्तः (ष्टुत्व-दोषः)।\
  *दोष-विश्लेषणम्:* 'न पदान्ताट्टोरनाम्' (८.४.४२) सूत्रेण पदान्त-टवर्गात् परस्य सकारस्य ष्टुत्वं न भवति। अतः सकारः तथैव तिष्ठति।\
  *शुद्ध-सन्धिः:* *षट् + सन्तः = षट् सन्तः*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १७ : 'षण्णाम्' पदे ष्टुत्व-विधानम्")[
  *अशुद्ध-रूपम्:* षट् नाम् = षड्नाम्।\
  *दोष-विश्लेषणम्:* यद्यपि पदान्त-टवर्गात् ष्टुत्व-निषेधः अस्ति, तथापि 'अनाम्' वार्तिकेन 'नाम्' शब्दे परे ष्टुत्वं भवत्येव। ततः अनुनासिके 'षण्णाम्' सिध्यति।\
  *शुद्ध-सन्धिः:* *षट् + नाम् = षण्णाम्*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १८ : 'हरिः शेते' पदे विसर्ग-विकल्पः")[
  *सन्धिरूप-द्वयम्:* हरिः + शेते = हरिः शेते अथवा हरिश्शेते।\
  *दोष-विश्लेषणम्:* 'वा शरि' (८.३.३६) सूत्रेण शर्-प्रत्याहारे (श्) परे विसर्गस्य विसर्ग एव वा भवति, पक्षे सत्व-श्चुत्वाभ्यां शकारोऽपि भवति। उभयमपि शुद्धम्।\
  *शुद्ध-रूपे:* *हरिः शेते (विसर्ग-पक्षे) / हरिश्शेते (श्चुत्व-पक्षे)*।
]

#worked-example("CUET अभ्यास-प्रकरणम् १९ : 'विष्णू इमौ' पदे प्रगृह्य-प्रकृतिभावः")[
  *अशुद्ध-सन्धिः:* विष्णू + इमौ = विष्ण्विमौ (यण्-दोषः)।\
  *दोष-विश्लेषणम्:* 'ईदूदेद् द्विवचनं प्रगृह्यम्' (१.१.११) सूत्रेण द्विवचनान्त-ऊकारस्य प्रगृह्य-संज्ञा भवति। प्रगृह्येभ्यः परं स्वर-संयोगेऽपि सन्धिः न भवति।\
  *शुद्ध-रूपम्:* *विष्णू + इमौ = विष्णू इमौ (प्रकृतिभावः)*।
]

#worked-example("CUET अभ्यास-प्रकरणम् २० : 'स्वैरः' पदे वार्तिक-वृद्धिः")[
  *अशुद्ध-विच्छेदः:* स्वै + इरः अथवा स्व + एरः।\
  *दोष-विश्लेषणम्:* 'स्वादीरेरिणोः' वार्तिकेन 'स्व' शब्दात् परस्य 'ईर' शब्दस्य गुणे प्राप्ते वृद्धिः (ऐ) एकादेशो भवति।\
  *शुद्ध-विच्छेदः:* *स्व + ईरः = स्वैरः (वृद्धि-वार्तिकम्)*।
]

#worked-example("CUET अभ्यास-प्रकरणम् २१ : 'कश्चित्' पदे सत्व-श्चुत्व-क्रमः")[
  *अशुद्ध-विच्छेदः:* कश् + चित्।\
  *दोष-विश्लेषणम्:* 'कः + चित्' इत्यत्र विसर्जनीयस्य सकारे 'कस् + चित्' भवति, ततः 'स्तोः श्चुना श्चुः' सूत्रेण सकारस्य शकारे 'कश्चित्' सिध्यति। मूलपदं 'कः' अस्ति।\
  *शुद्ध-विच्छेदः:* *कः (कस्) + चित् = कश्चित्*।
]

#worked-example("CUET अभ्यास-प्रकरणम् २२ : 'तन्मित्रम्' पदे अनुनासिक-सन्धिः")[
  *अशुद्ध-विच्छेदः:* तन् + मित्रम्।\
  *दोष-विश्लेषणम्:* 'यरोऽनुनासिकेऽनुनासिको वा' (८.४.४५) सूत्रेण पदान्त-तकारस्य मकारे परे विकल्पेन अनुनासिकः (न) भवति: तत् + मित्रम् = तन्मित्रम् / तद्मित्रम्।\
  *शुद्ध-विच्छेदः:* *तत् + मित्रम् = तन्मित्रम्*।
]

#worked-example("CUET अभ्यास-प्रकरणम् २३ : 'उल्लेखः' पदे तोर्लि-लत्वम्")[
  *अशुद्ध-विच्छेदः:* उल् + लेखः।\
  *दोष-विश्लेषणम्:* 'तोर्लि' (८.४.६०) सूत्रेण तवर्गस्य लकारे परे परसवर्णः लकार आदेशो भवति। विच्छेदे मूल-उपसर्गः 'उत्' (उद्) भवति।\
  *शुद्ध-विच्छेदः:* *उत् + लेखः = उल्लेखः*।
]

#worked-example("CUET अभ्यास-प्रकरणम् २४ : 'भो देवाः' पदे विसर्ग-लोपः")[
  *अशुद्ध-सन्धिः:* भोः + देवाः = भोर्देवाः (रुत्व-दोषः)।\
  *दोष-विश्लेषणम्:* 'भोभगोअघोअपूर्वस्य योऽशि' (८.३.१७) सूत्रेण भोस्-शब्दस्य अशि परे यत्वे ततः लोपे च 'भो देवाः' भवति। विसर्गस्य लोपो नित्यम्।\
  *शुद्ध-सन्धिः:* *भोः + देवाः = भो देवाः*।
]
